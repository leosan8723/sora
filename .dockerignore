# Keep the Docker build context minimal, secret-free and cPanel-safe.
# Only backend/, frontend/, docker/ and the Dockerfile are consumed by the
# build; everything else (git history, local backups, deployment packages,
# design references, .env files, build artifacts) is never sent to the
# daemon and never enters the image.

# Local history, artifacts and references
.git
.agents
backups
deploy
sample.html
skills-lock.json
*.zip

# Environment files — production values come exclusively from Railway vars
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
.env
.env.*

# Dependencies and build artifacts (rebuilt inside the image)
node_modules
frontend/node_modules
backend/vendor
backend/public/build
backend/bootstrap/cache/*.php

# Local runtime logs / test databases (never deployed)
backend/storage/logs/*
backend/database/*.sqlite
backend/database/*.sqlite-journal
